# Signal Hound SDK used to check the bindings and to test them in CI. It is
# downloaded at build time and never bundled: the API license does not allow
# merging it into other software. Sourced by native/fetch-sdk.sh and read by
# the GitHub workflows. To move to a new SDK, change these values and open a
# pull request; native/check-bindings.sh then lists any new functions.
#
# Signal Hound names each SDK zip after its release date and removes old ones,
# so the nightly build looks up the current zip on SDK_PAGE.
SDK_URL=https://signalhound.com/sigdownloads/SDK/signal_hound_sdk_10_05_26.zip
SDK_SHA256=e4c6e553bf19868bdc570746a00554d39bb91eb5d7acf661c9e8276fd98dc9e5
SDK_PAGE=https://signalhound.com/software/signal-hound-software-development-kit-sdk/
